            "value": "const numbers = [];\n\nwhile (numbers.length < 5) {\n  const number = Math.floor(Math.random() * 49) + 1;\n\n  if (!numbers.includes(number)) {\n    numbers.push(number);\n  }\n}\n\nnumbers.sort((a, b) => a - b);\n\nconst lucky = Math.floor(Math.random() * 10) + 1;\n\nreturn { random: { numbers, lucky } };"
