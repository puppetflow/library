      {
        "id": "Code-1790379695949-20",
        "name": "Code",
        "label": "Code",
        "x": 408,
        "y": -108,
        "values": {
          "code": {
            "mode": "fixed",
            "value": "const numbers = [];\n\nwhile (numbers.length < 5) {\n  const number = Math.floor(Math.random() * 49) + 1;\n\n  if (!numbers.includes(number)) {\n    numbers.push(number);\n  }\n}\n\nnumbers.sort((a, b) => a - b);\n\nconst stars = [];\n\nwhile (stars.length < 2) {\n  const star = Math.floor(Math.random() * 49) + 1;\n\n  if (!stars.includes(star)) {\n    stars.push(star);\n  }\n}\n\nstars.sort((a, b) => a - b);\n\nconst result = {\n  numbers,\n  stars\n};\n\n$run.result = result;"
          }
        }
      }
